# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5174
# Absolute URL of this API, used to build links to locally stored uploads.
PUBLIC_URL=http://localhost:5000

# ---- Database (Neon / local Postgres) ----
# Pooled connection, used by the running application.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled) connection, used by Prisma for migrations only.
# On Neon this is the same URL with "-pooler" removed from the host.
# With a plain local Postgres, set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth ----
# Use a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=1
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Email (SMTP) ----
# Leave SMTP_USER and SMTP_PASS empty in development and verification codes are
# logged to the console instead of sent, so no external account is needed.
#
# Gmail needs an App Password, not your normal password: turn on 2-Step
# Verification, then create one at
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# The Gmail address the codes are sent from.
SMTP_USER=your.address@gmail.com
# The 16-character App Password, with the spaces Google shows removed. Not your
# normal account password — Google rejects that over SMTP.
SMTP_PASS=abcdefghijklmnop

# Optional. Defaults to SMTP_USER, which is the only sender Gmail accepts from
# an authenticated account — set it only to add a display name, and keep the
# address the same.
EMAIL_FROM=

# ---- Sign in ----
# How long "remember this device" skips the emailed sign-in code for. The
# password is still required every time; only the second factor is skipped.
TRUSTED_DEVICE_DAYS=7

# ---- Dev conveniences ----
# When true (non-production only) the OTP is echoed back in the API response
# and shown on the verification screen, so signup can be exercised without an
# inbox. The auth test suite needs it on. Leave it off once email works, or
# the code the customer is meant to read from their inbox is also on screen.
EXPOSE_DEV_OTP=false

# ---- Document storage ----
# With these set, documents go to Cloudinary. Left empty in development they
# are written to server/uploads instead, so the app runs with no external
# account. Production must set them: a platform instance has an ephemeral
# disk and locally stored uploads would be lost on the next deploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=investment-portal
MAX_UPLOAD_BYTES=5242880

# ---- Fund prices ----
# There is no market behind this application, so each fund's NAV is simulated:
# the server publishes one new price per day, drifting randomly between 100 and
# 130. Set to false if a real price feed is ever wired in.
NAV_SIMULATION=true
NAV_SIMULATION_INTERVAL_MINUTES=5

# ---- Investing ----
# Notional balance credited on approval. Real funding is out of scope.
INVESTABLE_CREDIT=1000000
