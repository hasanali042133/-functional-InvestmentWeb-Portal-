# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database (Neon / local Postgres) ----
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth ----
# Use a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Email (Resend) ----
# Leave RESEND_API_KEY empty in development to log OTPs to the console
# instead of sending real email.
RESEND_API_KEY=
EMAIL_FROM="Investment Portal <onboarding@resend.dev>"

# ---- Dev conveniences ----
# When true (non-production only) the OTP is echoed back in the API response
# so the flow can be tested without an inbox.
EXPOSE_DEV_OTP=true
